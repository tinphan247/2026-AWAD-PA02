# Variables currently read by src/main.js. Supply local values as needed.
# Inside a container set HOST=0.0.0.0 (the root Dockerfile already does).
PORT=
HOST=

# PA3: model (only on the worker, never in the sandbox).
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=
MODEL_SPEND_CAP_USD=
MODEL_TIMEOUT_MS=
# PA3: JSONL call log (anonymised prompts only).
MODEL_CALL_LOG=

# PA3: database. Render web + Oracle worker both use this.
DATABASE_URL=
# PA3: local fallback only.
DATABASE_PATH=

# PA3: worker
WORKER_ID=
POLL_INTERVAL_MS=
