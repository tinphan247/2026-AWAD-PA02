# Checker image (PA#3, criterion 6).
#   docker build -f Dockerfile.checker -t leetkob-checker .
# Runs with the model off and the network cut:
#   docker run --rm --network none --memory 1g --pids-limit 256 \
#     -v "$PWD/leetkob-eval:/data:ro" -v "$PWD/runs/out:/out" \
#     -e MODEL_OFF=1 leetkob-checker --dataset /data --out /out/predictions.jsonl

FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
# --ignore-scripts: the hard rules load tree-sitter-cpp's .wasm grammar; the
# package's native install script is not needed (and has no musl prebuild).
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY bin ./bin
COPY src ./src
# No USER line on purpose: the markers mount their own output folder, owned
# by whatever uid they have, and the checker must be able to write there. It
# only parses code (it never runs a submission) and runs with --network none.
ENTRYPOINT ["node", "bin/check.mjs"]
