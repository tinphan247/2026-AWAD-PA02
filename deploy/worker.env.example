# /etc/leetkob/worker.env on the worker VM (Azure, Oracle, any Ubuntu) — copy,
# fill, then:
#   sudo install -m 600 -o root -g root worker.env /etc/leetkob/worker.env
#
# systemd EnvironmentFile rules: one KEY=VALUE per line, no `export`, no spaces
# around `=`, and wrap a value in double quotes if it contains `#` or spaces.
# Never commit this file. The model key lives here and nowhere else.

NODE_ENV=production

# Neon pooled connection string, with sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/leetkob?sslmode=require

# Model key from Tùng. Set on this VM only: not on Render, not in the sandbox.
# The worker also accepts MODEL_API_KEY; GEMINI_API_KEY is the name the plan uses.
GEMINI_API_KEY=

MODEL_NAME=gemini-2.5-flash
# Per-call timeout; a timeout becomes an `unsure` verdict, never a deduction.
MODEL_TIMEOUT_MS=20000
# The per-lab budget is `labs.cost_cap_usd` in Postgres, not an env var. Set the
# Google-side spending cap in the console; the worker does not read it here.

# Optional JSONL copy of the call log. `model_calls` in Postgres is
# authoritative (the cost cap sums it); leave this empty to skip the file.
MODEL_CALL_LOG=/var/log/leetkob/model-calls.jsonl

# Queue lease owner and polling cadence. Raise POLL_INTERVAL_MS if Neon's
# free CU-hours run low; idle polls back off to WORKER_MAX_IDLE_MS.
WORKER_ID=azure-1
POLL_INTERVAL_MS=5000
WORKER_MAX_IDLE_MS=30000

# Image built by deploy/oracle-setup.sh from sandbox/Dockerfile.SANDBOX_IMAGE=leetkob-sandbox:latest
